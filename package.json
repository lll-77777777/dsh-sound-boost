{
  "name": "dsh-sound-boost",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：上传音频文件，自定义「需要你批准」和「任务完成」的提示音",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "sound", "notification"],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
